# Copy this file to .env.local and fill in your EmailJS values.
# These values are used in the browser. EmailJS public keys are designed for client-side use.
# Never put private server/API secrets in VITE_ variables.

VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key